# ---------------------------------------------------------------------------
# Template konfigurasi lokal (dev). SALIN menjadi `.env` — jangan commit.
#
# Produksi: gunakan nilai proyek `campus-express-prod` dan bucket `ce-public` /
# `ce-private` (lihat docs/secrets.md §4). Untuk rilis produksi, skrip di
# `scripts/release/release.mjs` memakai variabel lingkungan, bukan berkas ini.
# ---------------------------------------------------------------------------
# Firebase (client SDK — nilai di bawah memang publik)
# ---------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=campus-express-dev.firebaseapp.com
FIREBASE_PROJECT_ID=campus-express-dev
FIREBASE_PROJECT_NUMBER=
FIREBASE_STORAGE_BUCKET=campus-express-dev.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Produksi:
# FIREBASE_AUTH_DOMAIN=campus-express-prod.firebaseapp.com
# FIREBASE_PROJECT_ID=campus-express-prod
# FIREBASE_STORAGE_BUCKET=campus-express-prod.firebasestorage.app

# ---------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible) — RAHASIA, hanya untuk CLI/CI (bukan klien)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ce-public-dev
# Optional. Defaults to R2_BUCKET_NAME when empty.
R2_PRIVATE_BUCKET_NAME=ce-private-dev
R2_PUBLIC_DOMAIN=https://cdn-dev.campus-express.example

# Produksi:
# R2_BUCKET_NAME=ce-public
# R2_PRIVATE_BUCKET_NAME=ce-private
# R2_PUBLIC_DOMAIN=https://cdn.campus-express.example

# ---------------------------------------------------------------------------
# Seeder Firestore produksi (scripts/seed-tuntungan-hub.ts)
# ---------------------------------------------------------------------------
# Wajib untuk target produksi: path service account Cloud Datastore User.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\service-account-prod.json
# FIREBASE_PROJECT_ID=campus-express-prod
