{
  "name": "campus-express",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Campus Express monorepo — Fase 2 core business engine, data seeder, dan web frontend.",
  "scripts": {
    "build:functions": "npm --prefix backend/functions run build",
    "seed": "npm run build:functions && tsx scripts/seedLandmarks.ts",
    "seed:emulator": "npm run build:functions && tsx scripts/seedLandmarks.ts --emulator",
    "test:engine": "npm run build:functions && npm --prefix backend/firebase run test",
    "emulators": "firebase emulators:start --config backend/firebase/firebase.json --project demo-campus-express",
    "typecheck:functions": "npm --prefix backend/functions run typecheck",
    "typecheck:r2": "npm --prefix backend/cloudflare-r2 run typecheck",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "typecheck": "npm run typecheck:functions && npm run typecheck:r2",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:lint": "npm --prefix apps/web run lint"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "firebase-tools": "^15.34.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
