# Trusted Gateway — salin ke `.dev.vars` untuk `wrangler dev`.
# Rahasia produksi diisi via `wrangler secret put <NAME>` (lihat docs/secrets.md).
FIREBASE_PROJECT_ID=campus-express-dev
FIREBASE_PROJECT_NUMBER=000000000000
ALLOWED_ORIGINS=http://localhost:3000,https://campusexpress.example
APP_CHECK_ENFORCE=false
DISABLE_APP_CHECK=true

# Service account Firebase (JSON satu baris) untuk Firestore REST.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Kunci HMAC untuk tautan /f/:key (5 menit).
URL_SIGNING_KEY=

# Cloudflare R2 (S3-compatible presigner).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ce-public
R2_PRIVATE_BUCKET_NAME=ce-private
R2_PUBLIC_DOMAIN=https://cdn.campusexpress.example