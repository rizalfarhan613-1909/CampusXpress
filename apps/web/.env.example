# ---------------------------------------------------------------------------
# Campus Express Web — template konfigurasi PUBLIK (Next.js static export).
#
# Salin berkas ini menjadi `.env.local` lalu isi nilainya. Tanpa berkas ini
# aplikasi tetap berjalan dalam mode demo (data contoh lokal).
#
# PERINGATAN KEAMANAN — hanya nilai publik yang boleh ada di sini.
# Seluruh isi `NEXT_PUBLIC_*` ikut ter-bundle ke browser dan dapat dibaca siapa
# pun. JANGAN menambahkan kunci privat seperti R2_SECRET_ACCESS_KEY,
# R2_ACCESS_KEY_ID, FIREBASE_SERVICE_ACCOUNT_JSON, atau URL_SIGNING_KEY.
# Rahasia hanya disimpan sebagai secret Worker Cloudflare (`wrangler secret put`)
# atau konfigurasi Firebase Admin Functions. Frontend hanya menerima token
# publik / signed URL berdurasi pendek (≤ 5 menit).
# ---------------------------------------------------------------------------

# Endpoint publik Trusted Gateway (Cloudflare Workers) — docs/tech.md §8.
# Endpoint tulis (acceptBid, top-up, unggah) dipanggil dengan Bearer ID token.
NEXT_PUBLIC_GATEWAY_URL=

# Tile peta publik. OSRM dipanggil oleh Gateway di sisi server, bukan browser.
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Firebase Web SDK — public client config (BUKAN service account).
# `apiKey` Firebase memang publik; jangan tertukar dengan service account JSON.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=