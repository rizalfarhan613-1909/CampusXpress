# ---------------------------------------------------------------------------
# Campus Express Web — PRODUKSI (Next.js static export).
#
# Salin ke `.env.production` (gitignored) atau biarkan skrip rilis menulisnya:
#   node scripts/release/release.mjs web --gateway-url=https://<worker>.workers.dev
#
# Hanya `NEXT_PUBLIC_*`. Rahasia TIDAK boleh ada di sini (docs/secrets.md §5.4).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GATEWAY_URL=https://campus-express-gateway.<subdomain>.workers.dev
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=campus-express-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=campus-express-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=campus-express-prod.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
